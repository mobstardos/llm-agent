# ═══════════════════════════════════════════════════════════════════════
# LLM Agent — шаблон переменных окружения
# Скопируйте в .env и раскомментируйте/отредактируйте нужное.
# Полный справочник: docs/DATABASE.md §5
# ═══════════════════════════════════════════════════════════════════════

# ─── Сервер ────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000
# Корень проекта (абсолютный путь); заполняется автоматически
#PROJECT_ROOT=/opt/llm-agent

# ─── AI-модели (настраивается мастером first_run.py) ──────────────────
# Основной путь — браузер/куки DeepSeek; второстепенный — OpenAI-совместимый API:
#DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
#DEEPSEEK_API_KEY=sk-...

# ─── PostgreSQL: зеркала журнала/сессий/планов, память агентов ────────
# Полный DSN (приоритетнее PG_APP_*); принимается только postgres://
#DATABASE_URL=postgres://llmagent:secret@localhost:5432/llmagent
# Компоненты DSN, если DATABASE_URL не задан:
PG_APP_HOST=localhost
PG_APP_PORT=5432
PG_APP_USER=llmagent
PG_APP_PASSWORD=secret
PG_APP_DATABASE=llmagent
# Включение PG-бэкенда памяти (при недоступности — мягкий откат на SQLite)
PG_ENABLED=true
# Фоновая репликация: журнал/сессии/планы → PG
PG_REPLICATE=1
PG_REPLICATE_INTERVAL=15

# ─── Память агентов (pgvector, memory.tasks) ──────────────────────────
# 1 = включить фоновый индексатор зеркал в память агентов
AGENT_MEMORY=1
# Период индексации, секунды (минимум 30)
AGENT_MEMORY_INTERVAL=120
# Embedder: auto (bge-m3 при доступности, иначе hashing) | model | hash
AGENT_MEMORY_EMBEDDER=auto

# ─── Эксплуатация: бэкапы и ретенция ──────────────────────────────────
# Авто-бэкапы pg_dump
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP_LAST=7
BACKUP_INITIAL_DELAY_SECONDS=300
# Авто-ретенция зеркал: удалять строки старше N дней. 0 = ВЫКЛЮЧЕНО.
# Ручной прогон — вкладка «🛠 Эксплуатация» или POST /api/ops-admin/retention/run
PG_RETENTION_DAYS=0
PG_RETENTION_INTERVAL_HOURS=24

# ─── Мультиинстанс ────────────────────────────────────────────────────
# Уникальный идентификатор инстанса в реестре ops.instances
#INSTANCE_ID=office-pc-1

# ─── Supervisor / оркестрация ─────────────────────────────────────────
SUPERVISOR_ENABLED=1
#SUPERVISOR_PARALLEL=1
#MAX_CONCURRENT=4

# ─── Опциональные сервисы (docker compose) ────────────────────────────
# Граф Apache AGE (порт 5433)
AGE_ENABLED=false
#AGE_DSN=postgres://llmagent:secret@localhost:5433/llmagent
# CDC → Kafka (порт 9092)
KAFKA_ENABLED=false
# Redis-шина кластера
#CLUSTER_ENABLED=false
