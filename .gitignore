# ── Секреты и локальная конфигурация ─────────────────────────────
.env
.env.local
*.env.bak

# ── Runtime-данные (создаются на машине пользователя при старте) ──
# Вgit идут только встроенные профили реестра: data/profiles/*
data/*
!data/profiles/
!data/profiles/**

# ── Python ────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Node (сборка расширения) ──────────────────────────────────────
node_modules/

# ── Журналы и временные файлы ─────────────────────────────────────
logs/
*.log
nohup.out
.DS_Store
Thumbs.db
