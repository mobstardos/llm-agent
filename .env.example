# ═══════════════════════════════════════════════════════════════════════
# LLM Agent — шаблон переменных окружения
# Скопируйте в .env и раскомментируйте/отредактируйте нужное.
# Полный справочник: docs/DATABASE.md §5
#
# ВАЖНО: src/config.py читает WEB_HOST/WEB_PORT (не HOST/PORT).
# ═══════════════════════════════════════════════════════════════════════

# ─── Сервер ────────────────────────────────────────────────────────────
WEB_HOST=127.0.0.1
WEB_PORT=8000

# ─── Безопасность v2 (рекомендуется, если сервер виден не только вам) ──
# API-ключ: если задан — все /api/* и /ws требуют его (X-API-Key,
# Authorization: Bearer, ?api_key= или cookie после первого входа по ссылке
# http://127.0.0.1:8000/?api_key=ВАШ_КЛЮЧ). Пусто = открытый доступ.
#LLM_AGENT_API_KEY=change-me-to-a-long-random-string
# Разрешённые Origin для WebSocket через запятую (по умолчанию localhost):
#LLM_AGENT_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# Хост привязки сервера (по умолчанию 127.0.0.1; 0.0.0.0 — наружу, только с API-ключом):
#LLM_AGENT_HOST=127.0.0.1
# Пароль PostgreSQL для docker-compose (postgres и age-postgres):
#POSTGRES_PASSWORD=change_me_in_env
# Токен веб-панели сниффера (SNIFFER_WEB_TOKEN), опционально:
#SNIFFER_WEB_TOKEN=change-me-too
# Корень проекта (абсолютный путь); заполняется автоматически
#PROJECT_ROOT=C:\Users\User\llm-agent

# ─── Белый список рабочих папок (Фаза 3) ───────────────────────────────
# Через ";" или "," — только эти папки (и их подпапки) доступны агенту:
# /api/project/set, файловые инструменты, вложения. Пусто = только PROJECT_ROOT.
#WORKSPACE_ROOTS=C:\Users\User\llm-agent;D:\Projects\another

# ─── AI-модели (настраивается мастером first_run.py) ──────────────────
# DeepSeek и Qwen работают и без API-ключей — по кукам через расширение
# Bridge (⚙️ Настройки → «Мост»), см. docs/providers.md. Тогда ключи не нужны.
#DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
#DEEPSEEK_API_KEY=sk-...
# Модель сайта Qwen (куки-путь):
#QWEN_WEB_MODEL=qwen3.7-plus

# ─── Автообновление кук веб-чатов (Фаза 2) ────────────────────────────
# При «куки/токен протухли» web_chat сам повторит autofill через
# kimi-webbridge (Edge с вашей сессией) и повторит запрос один раз.
# COOKIE_AUTOFILL=1 — включено; =0 — только ручное обновление
# (вкладка «Мост» → кнопка ⟳ или POST /api/bridge/cookies/refresh).
#COOKIE_AUTOFILL=1
# Адрес daemon kimi-webbridge (если нестандартный):
#KIMI_WEBBRIDGE_URL=http://127.0.0.1:10086
# Транспорт autofill: только kimi-webbridge (browser_cookie3 не работает
# из-за шифрования Edge/Chrome app-bound; плейсхолдер на будущее).
#COOKIE_BROWSER=auto

# ─── QwenProxy (АЛЬТЕРНАТИВНЫЙ путь, нужен qpx CLI) ───────────────────
# Основной путь Qwen — куки (см. выше). Если прокси не используете:
QWENPROXY_ENABLED=false

# ─── PostgreSQL: зеркала журнала/сессий/планов, память агентов ────────
# Полный DSN (приоритетнее PG_APP_*); принимается только postgres://
#DATABASE_URL=postgres://llmagent:secret@localhost:5432/llmagent
# Компоненты DSN, если DATABASE_URL не задан:
PG_APP_HOST=localhost
PG_APP_PORT=5432
PG_APP_USER=llmagent
PG_APP_PASSWORD=secret
PG_APP_DATABASE=llmagent
# Включение PG-бэкенда памяти (при недоступности — мягкий откат на SQLite)
PG_ENABLED=true
# Фоновая репликация: журнал/сессии/планы → PG
PG_REPLICATE=1

# ─── Память агентов: auto | hash | model ──────────────────────────────
# auto — bge-m3, если получится загрузить, иначе быстрый hashing
# hash — детерминированный, мгновенно, без загрузки моделей
AGENT_MEMORY_EMBEDDER=auto

# ─── Supervisor-цикл (Plan → Execute → Observe → Re-plan) ─────────────
# SUPERVISOR_ENABLED=0 — чат работает по пути Этапа 1 (Orchestrator.handle())
#SUPERVISOR_ENABLED=1

# Ollama HTTP timeout, seconds (weak GPU: big agent prompts slower)
# OLLAMA_TIMEOUT=180

# ─── Прочее (имена переменных из вашей рабочей .env — значения заполните сами) ──
# Прямой OpenAI-совместимый провайдер (если не используете куки-путь):
#LLM_BASE_URL=
#LLM_API_KEY=
#LLM_MODEL=
# Куки-путь DeepSeek web (значения — из вашего браузера, НЕ публикуйте их):
#DEEPSEEK_AUTH_TOKEN=
#DEEPSEEK_DS_SESSION_ID=
#DEEPSEEK_SMIDV2=
#DEEPSEEK_THUMBCACHE=
# Куки-путь Qwen web (НЕ публикуйте значения):
#QWEN_WEB_COOKIES=
#QWEN_WEB_TOKEN=
#UniRouter-агрегатор (НЕ публикуйте значение):
#UNOROUTER_API_KEY=
#QWENPROXY_AUTO_START=false
# Пропуск автостарта MCP-серверов (быстрый старт без внешних зависимостей):
#SKIP_MCP=1
#SUPERVISOR_ENABLED=1
#OLLAMA_TIMEOUT=180
