# ═══════════════════════════════════════════════════════════════════════
# LLM Agent — пример конфигурации
# Скопируйте в .env и отредактируйте
# ═══════════════════════════════════════════════════════════════════════

# ─── LLM API (qwenproxy-cli) ──────────────────────────────────────────
LLM_BASE_URL=http://127.0.0.1:7936/v1
LLM_API_KEY=any-string-or-empty
LLM_MODEL=qwen3.8-max
LLM_TEMPERATURE=0.1

# ─── QwenProxy ────────────────────────────────────────────────────────
QWENPROXY_ENABLED=true
QWENPROXY_AUTO_START=true
QWENPROXY_HOST=127.0.0.1
QWENPROXY_PORT=7936

# ─── Корень проекта ───────────────────────────────────────────────────
PROJECT_ROOT=D:\Downloads\your_project

# ─── Web ──────────────────────────────────────────────────────────────
WEB_HOST=127.0.0.1
WEB_PORT=8000

# ─── Instance ─────────────────────────────────────────────────────────
INSTANCE_ID=
CLUSTER_ENABLED=false
REDIS_URL=redis://localhost:6379/0

# ═══════════════════════════════════════════════════════════════════════
# PostgreSQL + pgvector (Часть 1)
# ═══════════════════════════════════════════════════════════════════════
PG_ENABLED=true

# Автодетект при КАЖДОМ запуске (Task 24-b): если PostgreSQL слушает
# локально, а текущий DSN не отвечает — перебираются дефолтные пароли
# (словарь в src/db/autodetect.py), затем (в TTY) запрашивается пароль
# админа. После успеха создаётся роль/база llmagent и применяется схема
# (scripts/init_db.py — идемпотентен). Отчёт: data/db_autodetect.json,
# GET /api/db/autodetect. Явно заданный DATABASE_URL автоматически
# не переписывается.

# Полный DSN (если задан — приоритет над PG_APP_*)
DATABASE_URL=
# DATABASE_URL=postgresql://llmagent:secret@localhost:5432/llmagent

# Компоненты (используются если DATABASE_URL пуст)
PG_APP_HOST=localhost
PG_APP_PORT=5432
PG_APP_USER=llmagent
PG_APP_PASSWORD=secret
PG_APP_DATABASE=llmagent

# Pool
PG_POOL_MIN=2
PG_POOL_MAX=20

# ─── Стратегия хранения ───────────────────────────────────────────────
# lancedb | postgres | dual
PRIMARY_VECTOR_STORE=postgres
# sqlite | postgres | dual
PRIMARY_EPISODIC_STORE=postgres
# sqlite | postgres | dual
PRIMARY_GRAPH_STORE=postgres
# dual-write (пишем в оба)
DUAL_WRITE_ENABLED=false

# ═══════════════════════════════════════════════════════════════════════
# Ollama (малая LLM для обогащения, Часть 2)
# ═══════════════════════════════════════════════════════════════════════
OLLAMA_ENABLED=true
OLLAMA_URL=http://127.0.0.1:11434
# Модель: qwen2.5:1.5b-instruct (~1 GB VRAM, универсал)
#         deepseek-r1-distill-qwen:1.5b (~1.1 GB VRAM, reasoning)
OLLAMA_MODEL=qwen2.5:1.5b-instruct
OLLAMA_KEEP_ALIVE=5m
OLLAMA_TIMEOUT=60

# EnrichmentWorker
ENRICH_BATCH_SIZE=50
ENRICH_INTERVAL=30
ENRICH_CONCURRENCY=4

# ── Локальные микрозадачи (Task 24-c): заголовки чатов/планов, теги,
#    дайджест журнала. Одна модель на всё — свопов VRAM на 2 ГБ нет.
LOCAL_MICRO_TASKS_ENABLED=1
# LOCAL_MICRO_MODEL=qwen2.5:1.5b-instruct
LOCAL_MICRO_INTERVAL=60
LOCAL_MICRO_DIGEST_INTERVAL=3600

# ── Выбор модели в чате (Task 24-c/24-d): провайдеры в config/models.yaml.
#    Ключ провайдера в .env → его модели появятся в селекте чата.
#    Полный список провайдеров и «как добавить своего»: docs/providers.md
# DEEPSEEK_API_KEY=
# QWENPROXY_URL=http://127.0.0.1:7936/v1
# OPENROUTER_API_KEY=          # openrouter.ai — сотни моделей, есть free
# SILICONFLOW_API_KEY=         # siliconflow.cn — free Qwen/DeepSeek, доступен из РФ
# VSEGPT_API_KEY=              # vsegpt.ru — оплата картами РФ
# PROXYAPI_API_KEY=            # proxyapi.ru — оплата картами РФ
# ANTHROPIC_API_KEY=           # Claude через OpenAI-совместимый endpoint
# GEMINI_API_KEY=              # Google Gemini (из РФ — только через прокси)
# GEMINI_URL=                  # свой прокси к generativelanguage.googleapis.com
# GROQ_API_KEY=                # groq.com (из РФ — через прокси)
# MISTRAL_API_KEY=             # mistral.ai
# LMSTUDIO_URL=http://127.0.0.1:1234   # LM Studio (локально, GUI)
# Fallback-цепочка через запятую (переопределяет selection.fallbacks
# из config/models.yaml): если модель недоступна — авто-переход
# LLM_FALLBACKS=qwen3.8-max,ollama_local/qwen2.5:1.5b-instruct

# ═══════════════════════════════════════════════════════════════════════
# Apache AGE (property graph, Часть 4)
# ═══════════════════════════════════════════════════════════════════════
# ВНИМАНИЕ: AGE не работает нативно на Windows. Только Docker/WSL2.
AGE_ENABLED=false
AGE_DSN=postgresql://llmagent:secret@localhost:5433/llmagent
AGE_GRAPH=llm_graph

# ═══════════════════════════════════════════════════════════════════════
# Kafka (CDC, Часть 4)
# ═══════════════════════════════════════════════════════════════════════
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PREFIX=llmagent.cdc

# ═══════════════════════════════════════════════════════════════════════
# Backup (Часть 5)
# ═══════════════════════════════════════════════════════════════════════
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_INITIAL_DELAY_SECONDS=300
BACKUP_KEEP_LAST=7
BACKUP_DIR=

# ═══════════════════════════════════════════════════════════════════════
# Кэш / Стриминг
# ═══════════════════════════════════════════════════════════════════════
CACHE_ENABLED=true
CACHE_TTL=3600
CACHE_REPLAY_SPEED=1.0

STREAMING_ENABLED=true
STREAMING_REPLAY_DELAY=0.01

# ═══════════════════════════════════════════════════════════════════════
# Policies
# ═══════════════════════════════════════════════════════════════════════
POLICY_TTL_DAYS=30
POLICY_CLEANUP_INTERVAL_HOURS=6
POLICY_DELETED_HISTORY_LIMIT=1000
POLICY_BACKUP_ON_EXIT=true
POLICY_BACKUP_INTERVAL_HOURS=24
POLICY_BACKUP_KEEP=7
POLICY_BACKUP_INITIAL_DELAY_MINUTES=5

# ═══════════════════════════════════════════════════════════════════════
# FileState / Loop / Harness
# ═══════════════════════════════════════════════════════════════════════
FILE_STATE_TTL=1.0
FILE_STATE_MAX_FILES=50000

LOOP_MAX_ITERATIONS=15
LOOP_MAX_TOKENS=50000
LOOP_MAX_DURATION_SECONDS=600
LOOP_SOFT_LIMIT=0.7
LOOP_HARD_LIMIT=0.85
LOOP_KILL_LIMIT=0.95

HARNESS_RUNS_DIR=data/harness_runs
HARNESS_KEEP_RUNS=true
HARNESS_DETERMINISTIC=false

# ═══════════════════════════════════════════════════════════════════════
# DeepSeek (веб-токены)
# Заполняются АВТОМАТИЧЕСКИ через расширение (Task 24-a): popup →
# «🔑 DeepSeek» → войти в chat.deepseek.com → куки прилетают сами.
# ═══════════════════════════════════════════════════════════════════════
DEEPSEEK_DS_SESSION_ID=
DEEPSEEK_SMIDV2=
DEEPSEEK_THUMBCACHE=
DEEPSEEK_AUTH_TOKEN=

# ─── Куки веб-чата Qwen (Task 24-a, расширение → «🔑 Qwen») ───────────
# Достаточно для чата моделей qwen_web БЕЗ qwenproxy и Node.js:
# модель «Qwen веб-чат (куки)» появится в селекте после входа через Bridge.
# Модель сайта можно поменять: QWEN_WEB_MODEL=qwen3-max-thinking
QWEN_WEB_COOKIES=
QWEN_WEB_TOKEN=

# ═══════════════════════════════════════════════════════════════════════
# MySQL / SQLite (MCP-сервер)
# ═══════════════════════════════════════════════════════════════════════
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
SQLITE_PATH=

# ─── PostgreSQL MCP (отдельно от PG_APP) ──────────────────────────────
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=

# ═══════════════════════════════════════════════════════════════════════
# 1C OData
# ═══════════════════════════════════════════════════════════════════════
ONEC_BASE_URL=
ONEC_USER=
ONEC_PASSWORD=

# ─── 1C Designer ──────────────────────────────────────────────────────
ONEC_1CV8_PATH=
ONEC_IB_PATH=
ONEC_DESIGNER_USER=
ONEC_DESIGNER_PASSWORD=
ONEC_LOG_LOCALE=ru

# ─── 1C Metadata / Tests ──────────────────────────────────────────────
ONEC_CONFIG_DIR=
ONEC_VANESSA_EPF=
ONEC_FEATURES_DIR=
ONEC_TESTS_TIMEOUT=1800

# ═══════════════════════════════════════════════════════════════════════
# Database Extended
# ═══════════════════════════════════════════════════════════════════════
REDIS_URL=
MONGO_URL=
MONGO_DB=
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DB=
ES_URL=
ES_USER=
ES_PASSWORD=

# ═══════════════════════════════════════════════════════════════════════
# CI/CD
# ═══════════════════════════════════════════════════════════════════════
GITLAB_URL=
GITLAB_TOKEN=
GITLAB_PROJECT=
JENKINS_URL=
JENKINS_USER=
JENKINS_TOKEN=

# ═══════════════════════════════════════════════════════════════════════
# GitHub
# ═══════════════════════════════════════════════════════════════════════
GITHUB_TOKEN=
GITHUB_REPO=

# ═══════════════════════════════════════════════════════════════════════
# Monitoring
# ═══════════════════════════════════════════════════════════════════════
PROMETHEUS_URL=
JAEGER_URL=

# ═══════════════════════════════════════════════════════════════════════
# Kubernetes
# ═══════════════════════════════════════════════════════════════════════
KUBECONFIG=
K8S_CONTEXT=
K8S_NAMESPACE=default

# ═══════════════════════════════════════════════════════════════════════
# Browser
# ═══════════════════════════════════════════════════════════════════════
BROWSER_HEADLESS=true
BROWSER_TYPE=chromium

# ═══════════════════════════════════════════════════════════════════════
# Whisper (Media)
# ═══════════════════════════════════════════════════════════════════════
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ═══════════════════════════════════════════════════════════════════════
# Storage (S3/MinIO/local)
# ═══════════════════════════════════════════════════════════════════════
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=data/storage
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_BUCKET=llmagent
S3_USE_SSL=true

# ═══════════════════════════════════════════════════════════════════════
# Journal — event sourcing (журнал действий, откат, реплей)
# ═══════════════════════════════════════════════════════════════════════
JOURNAL_ENABLED=true

# Retention — память копится, пока есть место на диске
JOURNAL_DISK_SOFT_LIMIT=0.85   # при 85% — архивация
JOURNAL_DISK_HARD_LIMIT=0.92   # при 92% — удаление старого
JOURNAL_DISK_TARGET=0.75       # удалять до 75%
JOURNAL_MIN_KEEP_DAYS=30       # минимум хранить дней
